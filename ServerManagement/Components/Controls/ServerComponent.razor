@inject NavigationManager NavigationManager
@inject IServersEFCoreRepository ServersEfCoreRepository


@if (Server != null)
{

    <tr style="background-color: @GetBackgroundColor()">
        <td>
            @Server.Name
        </td>
        <td>
            @Server.City
        </td>
        <td style="color: @((Server.IsOnline ? "green" : "red"))">
            @(Server.IsOnline ? "online" : "offline")
        </td>
        <td>
            @if (Server.IsOnline)
            {
                Random random = new Random();
                int randomNumber = random.Next(0, 500);
                <text>users: @randomNumber</text>
            }
            else
            {
                <text>N/A</text>
            }
        </td>
        <td>
            @if (Server.IsOnline)
            {

                <button type="button" class="btn btn-outline-danger" @onclick="@(async () => await SetServerStatus(false))">
                    Turn Off
                </button>
            }
            else
            {
                <button type="button" class="btn btn-outline-success" @onclick="@(async () => await SetServerStatus(true))">
                    Turn On
                </button>

            }
            &nbsp;
            <a href="/servers/@Server.ServerId" class="btn btn-outline-primary">Edit</a>
        </td>
        <td>
            <EditForm Model="Server" FormName="@($"form-Server-{Server.ServerId}")" OnValidSubmit="@(() => { DeleteServer(Server.ServerId); })">
                <button type="submit" class="btn btn-primary">Delete</button>
            </EditForm>
        </td>
    </tr>
}


@code {

    [CascadingParameter(Name = "SelectedCity")]
    public string? SelectedCity { get; set; }

    [Parameter]
    public Server? Server { get; set; }


    private void DeleteServer(int serverId)
    {
        if (serverId > 0)
        {
            ServersEfCoreRepository.DeleteServer(serverId);
            // forzo il re-load ... solo per ora
            NavigationManager.NavigateTo("/servers", true);

        }
    }


    private string GetBackgroundColor()
    {
        if (SelectedCity != null)
        {
            switch (SelectedCity)
            {
                case "Toronto":
                    return "lightblue";
                case "Montreal":
                    return "lightgreen";
                case "Ottawa":
                    return "yellow";
                case "Calgary":
                    return "pink";
                case "Halifax":
                    return "white";
                default: return "white";
            }
        }
        return "white";
    }


    private async Task SetServerStatus(bool status)
    {
        if (Server is not null && Server.IsOnline != status)
        {
            Server.IsOnline = status;
            ServersEfCoreRepository.UpdateServer(Server.ServerId, Server);
            StateHasChanged();
        }
    }

}