@page "/serverstatus"

@rendermode InteractiveServer
@inject NavigationManager NavigationManager



<h3>SetStatus</h3>
<br />
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}


<FieldComponent Label="Server Status">
    <Control>
        <input type="checkbox" @bind-value="isOnline"  class="form-check-input"/>
    </Control>
</FieldComponent>
<br />
<button type="button" class="btn btn-primary" @onclick="Save">Save</button>


@code {
    [SupplyParameterFromQuery]
    public string? CityName { get; set; }
    [SupplyParameterFromQuery]
    public string? ServerName { get; set; }
    private bool isOnline;

    private string? errorMessage;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            if (string.IsNullOrWhiteSpace(ServerName))
            {
                errorMessage = "Server Name is required.";
                StateHasChanged();
            }
            else if (string.IsNullOrWhiteSpace(CityName))
            {
                errorMessage = "City Name is required.";
                StateHasChanged();
            }
        }
    }

    private void Save()
        {

        if (string.IsNullOrWhiteSpace(ServerName))
        {
            errorMessage = "Server Name is required.";
            return;
        }
        else if (string.IsNullOrWhiteSpace(CityName))
        {
            errorMessage = "City Name is required.";
            return;
        }


        var server = new Server
            {
                Name = ServerName,
                City = CityName,
                IsOnline = isOnline
            };


        ServersRepository.AddServer(server);
        NavigationManager.NavigateTo($"/servers/back_from/{CityName}");
    }
}
