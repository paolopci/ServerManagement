@page "/cityname"


@rendermode InteractiveServer
@inject NavigationManager NavigationManager

<h3>City Name</h3>
<br />





@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}



<FieldComponent Label="City Name">
    <Control>
        <input type="text" @bind-value="cityName" class="form-control" />
    </Control>
</FieldComponent>
<br />
<button class="btn btn-primary" @onclick="GoNext">Next</button>


@code {
    private string? cityName;
    private string? errorMessage;

    [SupplyParameterFromQuery]
    public string? ServerName { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            if (string.IsNullOrWhiteSpace(ServerName))
            {
                errorMessage = "Server Name is required.";
                StateHasChanged();
            }
        }
    }

    private void GoNext()
    {
        if (string.IsNullOrWhiteSpace(ServerName))
        {
            errorMessage = "Server Name is required.";
            StateHasChanged();
        }
        else if (string.IsNullOrWhiteSpace(cityName))
        {
            errorMessage = "City Name is required.";
        }
        else
        {
            NavigationManager.NavigateTo($"/serverstatus?servername={ServerName}&cityname={cityName}");
        }

    }

}
