@page "/browser_wasm_1"
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<h3>Browser Storage Step1</h3>
<br />
<br />
<br />
<input type="text" @bind-value="data" class="form-control" />
<br />
<br />
<br />
<button class="btn btn-primary" @onclick="GoNext">Go Next</button>

@code {
    private string data = "";

    private async Task GoNext()
    {
        await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", "demo-data", data);
        NavigationManager.NavigateTo("/browser_wasm_2");
    }

}
